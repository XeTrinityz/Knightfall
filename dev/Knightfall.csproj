<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compile check only. The game compiles scripts/ itself and never loads this build. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>BATMAN4</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <SdkDir>..\..\..\..\Binaries\Win64\sdk\</SdkDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\scripts\**\*.cs" />
  </ItemGroup>

  <!-- The same global usings BmSDK adds when it compiles a mod. -->
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="BmSDK.Framework" />
    <Using Include="Tomlyn.Model" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BmSDK" HintPath="$(SdkDir)BmSDK.dll" Private="false" />
    <Reference Include="Tomlyn" HintPath="$(SdkDir)Tomlyn.dll" Private="false" />
    <Reference Include="MoreLinq" HintPath="$(SdkDir)MoreLinq.dll" Private="false" />
  </ItemGroup>

</Project>
